<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniFileExplorer.ViewModels"
        xmlns:views="using:MiniFileExplorer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="MiniFileExplorer.Views.MainWindow"
        x:Name="MainWindowRoot"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mini File Explorer"
        Width="1200" Height="720"
        MinWidth="750" MinHeight="480"
        KeyDown="OnWindowKeyDown"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- Top Toolbar & Global Actions -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                <!-- Dual Pane Toggle Button -->
                <ToggleButton Grid.Column="0" 
                              IsChecked="{Binding IsDualPaneMode, Mode=TwoWay}"
                              ToolTip.Tip="Перемкнути двопанельний режим Total Commander (Tab для зміни активної панелі)"
                              Margin="0,0,10,0" 
                              Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="🗂" />
                        <TextBlock Text="2 Панелі" />
                    </StackPanel>
                </ToggleButton>

                <!-- Recursive Search (Everything-style) Box -->
                <Grid Grid.Column="1" Margin="0,0,10,0" ColumnDefinitions="*, Auto, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="🔍 Пошук Everything (*.cs, pdf)..."
                             Padding="8,4"
                             KeyDown="OnSearchBoxKeyDown"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="1" 
                            Command="{Binding StartSearchCommand}"
                            IsVisible="{Binding !IsSearching}"
                            ToolTip.Tip="Шукати рекурсивно по всьому піддереву"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4">
                        <TextBlock Text="🔍" Foreground="DodgerBlue" />
                    </Button>
                    <Button Grid.Column="2" 
                            Command="{Binding CancelSearchCommand}"
                            IsVisible="{Binding IsSearching}"
                            ToolTip.Tip="Зупинити пошук"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4">
                        <TextBlock Text="⏹" Foreground="Red" />
                    </Button>
                </Grid>

                <!-- Dual Pane Copy / Move quick actions (visible in dual mode) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" IsVisible="{Binding IsDualPaneMode}">
                    <Button Command="{Binding CopyBetweenPanesCommand}" 
                            ToolTip.Tip="Скопіювати в сусідню панель (F5)" 
                            Padding="8,4">
                        <TextBlock Text="📋 F5 Копіювати" />
                    </Button>
                    <Button Command="{Binding MoveBetweenPanesCommand}" 
                            ToolTip.Tip="Перемістити в сусідню панель (F6)" 
                            Padding="8,4">
                        <TextBlock Text="🚚 F6 Перемістити" />
                    </Button>
                </StackPanel>

                <!-- Toggle Preview Pane Button -->
                <ToggleButton Grid.Column="3" 
                              IsChecked="{Binding IsPreviewPaneVisible, Mode=TwoWay}"
                              ToolTip.Tip="Показати / приховати панель попереднього перегляду"
                              Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="👁" />
                        <TextBlock Text="Прев'ю" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Notification / Error Banner -->
        <Border Grid.Row="1" 
                IsVisible="{Binding HasBanner}"
                Background="#3A1D1D" 
                BorderBrush="#B22222" 
                BorderThickness="0,0,0,1" 
                Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding BannerMessage}" Foreground="#FF9999" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" 
                        Command="{Binding DismissBannerCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6,2" 
                        VerticalAlignment="Center">
                    <TextBlock Text="✕" Foreground="#FF9999" FontWeight="Bold" />
                </Button>
            </Grid>
        </Border>

        <!-- Search Mode Info Banner -->
        <Border Grid.Row="2" 
                IsVisible="{Binding IsSearchMode}"
                Background="#1B2A38" 
                BorderBrush="DodgerBlue" 
                BorderThickness="0,0,0,1" 
                Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding SearchStatusText}" Foreground="#AADDFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsSearching}" Width="80" Height="4" Margin="10,0" VerticalAlignment="Center" />
                <Button Grid.Column="3" 
                        Command="{Binding ExitSearchModeCommand}" 
                        Padding="10,2" 
                        Background="#2B3A48"
                        VerticalAlignment="Center">
                    <TextBlock Text="✕ Вийти з пошуку" Foreground="White" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Workspace: Sidebar + [Files Area (1 or 2 Panes)] + [Splitter + Preview] -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140" MaxWidth="300" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,1,0" 
                    Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ШВИДКИЙ ДОСТУП" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,6,8,2" />
                        <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                    <Button Background="Transparent" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Left"
                                            Padding="8,5" Margin="2,1"
                                            Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).NavigateToPathCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Path}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ЦЕЙ ПК (ДИСКИ)" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,8,8,2" />
                        <ItemsControl ItemsSource="{Binding DriveSidebarItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                    <Button Background="Transparent" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Left"
                                            Padding="8,5" Margin="2,1"
                                            Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).NavigateToPathCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Path}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 1: Files Area (Single pane or Dual pane) -->
            <Grid Grid.Column="1">
                <!-- Single Pane Mode -->
                <ContentControl IsVisible="{Binding !IsDualPaneMode}">
                    <views:FilePaneView DataContext="{Binding LeftPane}" />
                </ContentControl>

                <!-- Dual Pane Mode -->
                <Grid ColumnDefinitions="*, Auto, *" IsVisible="{Binding IsDualPaneMode}">
                    <views:FilePaneView Grid.Column="0" DataContext="{Binding LeftPane}" />
                    <GridSplitter Grid.Column="1" 
                                  Width="5" 
                                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                                  ResizeDirection="Columns" />
                    <views:FilePaneView Grid.Column="2" DataContext="{Binding RightPane}" />
                </Grid>
            </Grid>

            <!-- Column 2: Splitter between Files and Preview -->
            <GridSplitter Grid.Column="2" 
                          Width="5" 
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                          IsVisible="{Binding IsPreviewPaneVisible}" 
                          ResizeDirection="Columns" />

            <!-- Column 3: Preview Pane -->
            <Border Grid.Column="3" 
                    IsVisible="{Binding IsPreviewPaneVisible}"
                    Width="320" MinWidth="200" MaxWidth="700"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="{Binding Preview.IconGlyph}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview.Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview.FileSizeInfo}" Foreground="Gray" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Loading indicator -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Preview.IsLoading}" Height="2" />

                    <!-- Content Body -->
                    <Grid Grid.Row="2" Margin="10">
                        <!-- Empty State -->
                        <TextBlock Text="Виберіть файл для перегляду"
                                   IsVisible="{Binding Preview.IsEmpty}"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Folder State -->
                        <StackPanel IsVisible="{Binding Preview.IsFolder}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="Папка файлової системи" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Preview.FilePath}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="260" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Text / Code Preview -->
                        <ScrollViewer IsVisible="{Binding Preview.IsText}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding Preview.TextContent}" 
                                     IsReadOnly="True" 
                                     FontFamily="Consolas, Cascadia Code, Courier New, monospace" 
                                     FontSize="12" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>

                        <!-- Image Preview -->
                        <Grid IsVisible="{Binding Preview.IsImage}" RowDefinitions="*, Auto">
                            <Image Grid.Row="0" Source="{Binding Preview.ImagePreview}" Stretch="Uniform" />
                            <TextBlock Grid.Row="1" Text="{Binding Preview.ImageDimensions}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </Grid>

                        <!-- Binary / Other File Card -->
                        <Border IsVisible="{Binding Preview.IsBinary}" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" MaxWidth="260">
                            <StackPanel Spacing="10">
                                <TextBlock Text="⚙" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Preview.Title}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Розмір: " Foreground="Gray" FontSize="12" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.FileSizeInfo}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Змінено: " Foreground="Gray" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.ModifiedDateInfo}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="{Binding ActivePane.StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Grid.Column="1" Text="Активна: " Foreground="Gray" Margin="10,0,4,0" IsVisible="{Binding IsDualPaneMode}" />
                <TextBlock Grid.Column="2" Text="{Binding ActivePane.CurrentPath}" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="450" />
            </Grid>
        </Border>
    </Grid>
</Window>
