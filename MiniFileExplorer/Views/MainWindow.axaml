<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniFileExplorer.ViewModels"
        xmlns:models="using:MiniFileExplorer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="600"
        x:Class="MiniFileExplorer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mini File Explorer"
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto">
        <!-- Top Toolbar & Navigation -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto">
                <!-- Navigation buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                    <Button Command="{Binding GoUpCommand}" 
                            IsEnabled="{Binding CanGoUp}" 
                            ToolTip.Tip="Вгору (..)" 
                            Padding="8,4">
                        <TextBlock Text="⬆ Вгору" />
                    </Button>
                    <Button Command="{Binding RefreshCommand}" 
                            ToolTip.Tip="Оновити" 
                            Padding="8,4">
                        <TextBlock Text="🔄" />
                    </Button>
                </StackPanel>

                <!-- Drives Selector Dropdown -->
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Drives}" 
                          SelectedItem="{Binding CurrentPath}"
                          Width="130" Margin="0,0,8,0"
                          PlaceholderText="Диски">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DriveItem">
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Editable Address Bar -->
                <TextBox Grid.Column="2" 
                         Text="{Binding PathInput, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         PlaceholderText="Введіть шлях до папки..."
                         KeyDown="OnAddressBarKeyDown" />

                <!-- Go Button -->
                <Button Grid.Column="3" 
                        Command="{Binding NavigateFromInputCommand}" 
                        Margin="8,0,8,0" 
                        Padding="12,4">
                    <TextBlock Text="Перейти" />
                </Button>

                <!-- Calculate Folder Sizes Button -->
                <Button Grid.Column="4" 
                        Command="{Binding CalculateFolderSizesCommand}" 
                        IsEnabled="{Binding !IsCalculatingFolderSizes}"
                        ToolTip.Tip="Асинхронно порахувати реальний розмір кожної папки"
                        Margin="0,0,8,0" 
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📊" />
                        <TextBlock Text="{Binding IsCalculatingFolderSizes, Converter={x:Null}, FallbackValue='Розміри папок'}" />
                    </StackPanel>
                </Button>

                <!-- In-Folder Quick Filter -->
                <Grid Grid.Column="5" Width="200" ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding FilterQuery, Mode=TwoWay}"
                             PlaceholderText="🔍 Фільтр у папці..."
                             VerticalAlignment="Center" />
                    <Button Grid.Column="1" 
                            Command="{Binding ClearFilterCommand}"
                            IsVisible="{Binding FilterQuery.Length}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4">
                        <TextBlock Text="✕" Foreground="Gray" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Notification / Error Banner -->
        <Border Grid.Row="1" 
                IsVisible="{Binding HasBanner}"
                Background="#3A1D1D" 
                BorderBrush="#B22222" 
                BorderThickness="0,0,0,1" 
                Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding BannerMessage}" Foreground="#FF9999" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" 
                        Command="{Binding DismissBannerCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6,2" 
                        VerticalAlignment="Center">
                    <TextBlock Text="✕" Foreground="#FF9999" FontWeight="Bold" />
                </Button>
            </Grid>
        </Border>

        <!-- Quick Drives List Bar -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="8,4">
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveItem">
                        <Button Content="{Binding DisplayText}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                                CommandParameter="{Binding RootDirectory}"
                                Padding="8,2" FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Column Headers (Clickable for Sorting) -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid ColumnDefinitions="30, *, 120, 130, 160">
                <TextBlock Grid.Column="0" Text="" />
                
                <!-- Sort by Name -->
                <Button Grid.Column="1" 
                        Command="{Binding ToggleSortCommand}" 
                        CommandParameter="Name" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,2" 
                        HorizontalAlignment="Left">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Назва" /><Run Text="{Binding NameSortIndicator}" Foreground="DodgerBlue" />
                    </TextBlock>
                </Button>

                <!-- Sort by Type -->
                <Button Grid.Column="2" 
                        Command="{Binding ToggleSortCommand}" 
                        CommandParameter="Type" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,2" 
                        HorizontalAlignment="Left">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Тип" /><Run Text="{Binding TypeSortIndicator}" Foreground="DodgerBlue" />
                    </TextBlock>
                </Button>

                <!-- Sort by Size -->
                <Button Grid.Column="3" 
                        Command="{Binding ToggleSortCommand}" 
                        CommandParameter="Size" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,2" 
                        HorizontalAlignment="Right">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Розмір" /><Run Text="{Binding SizeSortIndicator}" Foreground="DodgerBlue" />
                    </TextBlock>
                </Button>

                <!-- Sort by Date -->
                <Button Grid.Column="4" 
                        Command="{Binding ToggleSortCommand}" 
                        CommandParameter="Date" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,2" 
                        HorizontalAlignment="Right">
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Дата зміни" /><Run Text="{Binding DateSortIndicator}" Foreground="DodgerBlue" />
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area: Files List -->
        <Grid Grid.Row="4">
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     DoubleTapped="OnItemListDoubleTapped"
                     KeyDown="OnItemListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileItemViewModel">
                        <Grid ColumnDefinitions="30, *, 120, 130, 160" Margin="0,2">
                            <!-- Icon / Glyph -->
                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            
                            <!-- Name -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding IsDirectory, Converter={x:Null}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                            
                            <!-- Type -->
                            <TextBlock Grid.Column="2" Text="{Binding TypeDescription}" Foreground="Gray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />

                            <!-- Size -->
                            <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                            
                            <!-- Modified Date -->
                            <TextBlock Grid.Column="4" Text="{Binding FormattedDate}" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Loading Spinner / Overlay -->
            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsLoading}" 
                         VerticalAlignment="Top" 
                         Height="4" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="400" />
            </Grid>
        </Border>
    </Grid>
</Window>
