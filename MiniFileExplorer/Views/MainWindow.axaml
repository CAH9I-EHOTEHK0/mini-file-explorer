<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniFileExplorer.ViewModels"
        xmlns:models="using:MiniFileExplorer.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
        x:Class="MiniFileExplorer.Views.MainWindow"
        x:Name="MainWindowRoot"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Mini File Explorer"
        Width="1150" Height="700"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Top Toolbar & Navigation -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                <!-- Navigation buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                    <Button Command="{Binding GoUpCommand}" 
                            IsEnabled="{Binding CanGoUp}" 
                            ToolTip.Tip="Вгору (..)" 
                            Padding="8,4">
                        <TextBlock Text="⬆ Вгору" />
                    </Button>
                    <Button Command="{Binding RefreshCommand}" 
                            ToolTip.Tip="Оновити" 
                            Padding="8,4">
                        <TextBlock Text="🔄" />
                    </Button>
                </StackPanel>

                <!-- Editable Address Bar -->
                <TextBox Grid.Column="1" 
                         Text="{Binding PathInput, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         PlaceholderText="Введіть шлях до папки..."
                         KeyDown="OnAddressBarKeyDown" />

                <!-- Go Button -->
                <Button Grid.Column="2" 
                        Command="{Binding NavigateFromInputCommand}" 
                        Margin="8,0,8,0" 
                        Padding="12,4">
                    <TextBlock Text="Перейти" />
                </Button>

                <!-- Calculate Folder Sizes Button -->
                <Button Grid.Column="3" 
                        Command="{Binding CalculateFolderSizesCommand}" 
                        IsEnabled="{Binding !IsCalculatingFolderSizes}"
                        ToolTip.Tip="Асинхронно порахувати реальний розмір кожної папки"
                        Margin="0,0,8,0" 
                        Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📊" />
                        <TextBlock Text="Розміри папок" />
                    </StackPanel>
                </Button>

                <!-- Toggle Preview Pane Button -->
                <ToggleButton Grid.Column="4" 
                              IsChecked="{Binding IsPreviewPaneVisible, Mode=TwoWay}"
                              ToolTip.Tip="Показати / приховати панель попереднього перегляду"
                              Margin="0,0,0,0" 
                              Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="👁" />
                        <TextBlock Text="Прев'ю" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Notification / Error Banner -->
        <Border Grid.Row="1" 
                IsVisible="{Binding HasBanner}"
                Background="#3A1D1D" 
                BorderBrush="#B22222" 
                BorderThickness="0,0,0,1" 
                Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding BannerMessage}" Foreground="#FF9999" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" 
                        Command="{Binding DismissBannerCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6,2" 
                        VerticalAlignment="Center">
                    <TextBlock Text="✕" Foreground="#FF9999" FontWeight="Bold" />
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area: Left Sidebar + Files Area + Splitter + Preview Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" MaxWidth="320" />
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" MinWidth="200" MaxWidth="800" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Windows-style Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,1,0" 
                    Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Quick Access Section -->
                        <TextBlock Text="ШВИДКИЙ ДОСТУП" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,6,8,2" />
                        <ItemsControl ItemsSource="{Binding QuickAccessItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                    <Button Background="Transparent" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" 
                                            Margin="2,1"
                                            Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).NavigateToCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Path}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Drives Section -->
                        <TextBlock Text="ЦЕЙ ПК (ДИСКИ)" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,10,8,2" />
                        <ItemsControl ItemsSource="{Binding DriveSidebarItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SidebarItemViewModel">
                                    <Button Background="Transparent" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6" 
                                            Margin="2,1"
                                            Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).NavigateToCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Path}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 1: Files Area with Column Headers and Filter -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <!-- Column Headers & Quick Filter Bar -->
                <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="12,4,12,4">
                    <Grid ColumnDefinitions="30, *, 120, 130, 160, 160">
                        <TextBlock Grid.Column="0" Text="" />
                        
                        <!-- Sort by Name -->
                        <Button Grid.Column="1" 
                                Command="{Binding ToggleSortCommand}" 
                                CommandParameter="Name" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4,2" 
                                HorizontalAlignment="Left">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Назва" /><Run Text="{Binding NameSortIndicator}" Foreground="DodgerBlue" />
                            </TextBlock>
                        </Button>

                        <!-- Sort by Type -->
                        <Button Grid.Column="2" 
                                Command="{Binding ToggleSortCommand}" 
                                CommandParameter="Type" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4,2" 
                                HorizontalAlignment="Left">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Тип" /><Run Text="{Binding TypeSortIndicator}" Foreground="DodgerBlue" />
                            </TextBlock>
                        </Button>

                        <!-- Sort by Size -->
                        <Button Grid.Column="3" 
                                Command="{Binding ToggleSortCommand}" 
                                CommandParameter="Size" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4,2" 
                                HorizontalAlignment="Right">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Розмір" /><Run Text="{Binding SizeSortIndicator}" Foreground="DodgerBlue" />
                            </TextBlock>
                        </Button>

                        <!-- Sort by Date -->
                        <Button Grid.Column="4" 
                                Command="{Binding ToggleSortCommand}" 
                                CommandParameter="Date" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4,2" 
                                HorizontalAlignment="Right">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Дата зміни" /><Run Text="{Binding DateSortIndicator}" Foreground="DodgerBlue" />
                            </TextBlock>
                        </Button>

                        <!-- In-Folder Quick Filter -->
                        <Grid Grid.Column="5" Margin="8,0,0,0" ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding FilterQuery, Mode=TwoWay}" 
                                     PlaceholderText="🔍 Фільтр..." 
                                     Padding="6,2" 
                                     FontSize="11" 
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1" 
                                    Command="{Binding ClearFilterCommand}" 
                                    IsVisible="{Binding FilterQuery.Length}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="4,2">
                                <TextBlock Text="✕" Foreground="Gray" FontSize="10" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Files List with Right-Click Context Menu -->
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             DoubleTapped="OnItemListDoubleTapped"
                             KeyDown="OnItemListKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItemViewModel">
                                <Grid ColumnDefinitions="30, *, 120, 130, 160" Margin="0,2">
                                    <!-- Context Menu on Right Click -->
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📂 Відкрити" 
                                                      Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).OpenItemCommand, FallbackValue={x:Null}}" 
                                                      CommandParameter="{Binding}" 
                                                      InputGesture="Enter" />
                                            <Separator />
                                            <MenuItem Header="📋 Копіювати як шлях" 
                                                      Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).CopyPathCommand, FallbackValue={x:Null}}" 
                                                      CommandParameter="{Binding}" 
                                                      InputGesture="Ctrl+Shift+C" />
                                            <Separator />
                                            <MenuItem Header="🗑 Видалити" 
                                                      Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).DeleteItemCommand, FallbackValue={x:Null}}" 
                                                      CommandParameter="{Binding}" 
                                                      InputGesture="Delete" />
                                            <Separator />
                                            <MenuItem Header="ℹ Властивості" 
                                                      Command="{Binding #MainWindowRoot.((vm:MainViewModel)DataContext).ShowPropertiesCommand, FallbackValue={x:Null}}" 
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Icon / Glyph -->
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    
                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding IsDirectory, Converter={x:Null}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                    
                                    <!-- Type -->
                                    <TextBlock Grid.Column="2" Text="{Binding TypeDescription}" Foreground="Gray" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />

                                    <!-- Size -->
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                                    
                                    <!-- Modified Date -->
                                    <TextBlock Grid.Column="4" Text="{Binding FormattedDate}" Foreground="Gray" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Loading Spinner / Overlay -->
                    <ProgressBar IsIndeterminate="True" 
                                 IsVisible="{Binding IsLoading}" 
                                 VerticalAlignment="Top" 
                                 Height="4" />
                </Grid>
            </Grid>

            <!-- Column 2: Splitter between files and preview -->
            <GridSplitter Grid.Column="2" 
                          Width="5" 
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                          IsVisible="{Binding IsPreviewPaneVisible}" 
                          ResizeDirection="Columns" />

            <!-- Column 3: Preview Pane -->
            <Border Grid.Column="3" 
                    IsVisible="{Binding IsPreviewPaneVisible}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1,0,0,0">
                
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="{Binding Preview.IconGlyph}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview.Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Preview.FileSizeInfo}" Foreground="Gray" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Loading indicator -->
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Preview.IsLoading}" Height="2" />

                    <!-- Content Body -->
                    <Grid Grid.Row="2" Margin="10">
                        <!-- Empty State -->
                        <TextBlock Text="Виберіть файл для перегляду"
                                   IsVisible="{Binding Preview.IsEmpty}"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Folder State -->
                        <StackPanel IsVisible="{Binding Preview.IsFolder}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="Папка файлової системи" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Preview.FilePath}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Text / Code Preview -->
                        <ScrollViewer IsVisible="{Binding Preview.IsText}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding Preview.TextContent}" 
                                     IsReadOnly="True" 
                                     FontFamily="Consolas, Cascadia Code, Courier New, monospace" 
                                     FontSize="12" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>

                        <!-- Image Preview -->
                        <Grid IsVisible="{Binding Preview.IsImage}" RowDefinitions="*, Auto">
                            <Image Grid.Row="0" Source="{Binding Preview.ImagePreview}" Stretch="Uniform" />
                            <TextBlock Grid.Row="1" Text="{Binding Preview.ImageDimensions}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </Grid>

                        <!-- Binary / Other File Card -->
                        <Border IsVisible="{Binding Preview.IsBinary}" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="16" MaxWidth="280">
                            <StackPanel Spacing="10">
                                <TextBlock Text="⚙" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Preview.Title}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Розмір: " Foreground="Gray" FontSize="12" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.FileSizeInfo}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Змінено: " Foreground="Gray" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.ModifiedDateInfo}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="400" />
            </Grid>
        </Border>
    </Grid>
</Window>
