<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiniFileExplorer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="MiniFileExplorer.Views.FilePaneView"
             x:Name="PaneRoot"
             x:DataType="vm:FilePaneViewModel">

    <Border BorderBrush="{Binding IsActive, Converter={x:Null}, FallbackValue=Transparent}" 
            BorderThickness="1" 
            CornerRadius="14"
            Classes.active="{Binding IsActive}">
        <Border.Styles>
            <Style Selector="Border.active">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
            </Style>
        </Border.Styles>

        <Grid RowDefinitions="Auto, Auto, *">
            <!-- Pane Navigation & Address Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource AppHeaderBackground}" 
                    BorderBrush="{DynamicResource AppHeaderBorder}" 
                    BorderThickness="0,0,0,1" 
                    Padding="8,6">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                        <Button Command="{Binding GoUpCommand}" 
                                IsEnabled="{Binding CanGoUp}" 
                                ToolTip.Tip="Вгору (..)" 
                                Padding="6,4"
                                CornerRadius="6">
                            <Image Source="avares://MiniFileExplorer/Assets/Icons/icons8-up-64.png" Width="16" Height="16" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}" 
                                ToolTip.Tip="Оновити" 
                                Padding="6,4"
                                CornerRadius="6">
                            <Image Source="avares://MiniFileExplorer/Assets/Icons/icons8-sync-64.png" Width="16" Height="16" />
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Column="1" 
                             Text="{Binding PathInput, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             Padding="8,5" FontSize="12"
                             CornerRadius="6"
                             PlaceholderText="Шлях до папки..."
                             KeyDown="OnAddressBarKeyDown" />

                    <Button Grid.Column="2" 
                            Command="{Binding NavigateFromInputCommand}" 
                            ToolTip.Tip="Перейти за введеним шляхом"
                            Margin="6,0,0,0" 
                            Padding="6,4"
                            CornerRadius="6">
                        <Image Source="avares://MiniFileExplorer/Assets/Icons/icons8-right-64.png" Width="16" Height="16" />
                    </Button>

                    <!-- Toggle View Mode Button (Details / Large Icons Grid) -->
                    <Button Grid.Column="3" 
                            Command="{Binding ToggleViewModeCommand}" 
                            ToolTip.Tip="{Binding ViewModeToolTip}"
                            Margin="6,0,0,0" 
                            Padding="8,4"
                            CornerRadius="6">
                        <TextBlock Text="{Binding ViewModeGlyph}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Column Headers & In-Pane Quick Filter (Visible in Details mode) -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding IsDetailsView}"
                    Background="{DynamicResource AppHeaderBackground}" 
                    BorderBrush="{DynamicResource AppHeaderBorder}" 
                    BorderThickness="0,0,0,1" 
                    Padding="10,2">
                <Grid x:Name="HeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="{Binding ColNameWidth, Mode=TwoWay}" MinWidth="60" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{Binding ColTypeWidth, Mode=TwoWay}" MinWidth="40" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{Binding ColSizeWidth, Mode=TwoWay}" MinWidth="40" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="{Binding ColDateWidth, Mode=TwoWay}" MinWidth="60" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="60" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="" />

                    <!-- Sort by Name -->
                    <Button Grid.Column="1" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Name" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2,3" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Назва" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="11" />
                            <Image Source="{Binding NameSortBitmap}" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding NameSortBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                    <GridSplitter Grid.Column="2" Width="6" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWestEast">
                        <GridSplitter.Template>
                            <ControlTemplate>
                                <Border Background="Transparent">
                                    <Border Width="1" Background="{DynamicResource AppHeaderBorder}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Sort by Type -->
                    <Button Grid.Column="3" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Type" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2,3" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Тип" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="11" />
                            <Image Source="{Binding TypeSortBitmap}" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding TypeSortBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                    <GridSplitter Grid.Column="4" Width="6" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWestEast">
                        <GridSplitter.Template>
                            <ControlTemplate>
                                <Border Background="Transparent">
                                    <Border Width="1" Background="{DynamicResource AppHeaderBorder}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Sort by Size -->
                    <Button Grid.Column="5" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Size" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2,3" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="Розмір" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="11" />
                            <Image Source="{Binding SizeSortBitmap}" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding SizeSortBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                    <GridSplitter Grid.Column="6" Width="6" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWestEast">
                        <GridSplitter.Template>
                            <ControlTemplate>
                                <Border Background="Transparent">
                                    <Border Width="1" Background="{DynamicResource AppHeaderBorder}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Sort by Date -->
                    <Button Grid.Column="7" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Date" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2,3" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="Дата" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontSize="11" />
                            <Image Source="{Binding DateSortBitmap}" Width="10" Height="10" VerticalAlignment="Center" IsVisible="{Binding DateSortBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                    <GridSplitter Grid.Column="8" Width="6" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWestEast">
                        <GridSplitter.Template>
                            <ControlTemplate>
                                <Border Background="Transparent">
                                    <Border Width="1" Background="{DynamicResource AppHeaderBorder}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>

                    <!-- Quick Filter -->
                    <Grid Grid.Column="9" Margin="6,0,0,0" ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilterQuery, Mode=TwoWay}" 
                                 PlaceholderText="..." 
                                 Padding="5,2" 
                                 CornerRadius="6"
                                 FontSize="10" 
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                 Command="{Binding ClearFilterCommand}" 
                                 IsVisible="{Binding FilterQuery.Length}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="2">
                            <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Filter Bar in Large Icons Grid Mode -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding IsGridView}"
                    Background="{DynamicResource AppHeaderBackground}" 
                    BorderBrush="{DynamicResource AppHeaderBorder}" 
                    BorderThickness="0,0,0,1" 
                    Padding="10,5">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Вигляд: Великі піктограми" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleSortCommand}" CommandParameter="Name" Background="Transparent" BorderThickness="0" Padding="4,2">
                            <TextBlock FontSize="11"><Run Text="Сортувати за ім'ям" Foreground="{DynamicResource TextSecondary}" /><Run Text="{Binding NameSortIndicator}" Foreground="{DynamicResource AccentBlue}" /></TextBlock>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="140" ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilterQuery, Mode=TwoWay}" 
                                 PlaceholderText="🔍 Фільтр..." 
                                 Padding="5,2" 
                                 CornerRadius="6"
                                 FontSize="10" 
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                 Command="{Binding ClearFilterCommand}" 
                                 IsVisible="{Binding FilterQuery.Length}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="2">
                            <TextBlock Text="✕" Foreground="{DynamicResource TextMuted}" FontSize="9" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Files List Area -->
            <Grid Grid.Row="2" PointerPressed="OnPanePointerPressed">
                <!-- Mode 1: Details Table ListBox -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DoubleTapped="OnItemListDoubleTapped"
                         KeyDown="OnItemListKeyDown"
                         GotFocus="OnListBoxGotFocus"
                         IsVisible="{Binding IsDetailsView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Margin" Value="2,1" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ColNameWidth}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ColTypeWidth}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ColSizeWidth}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ColDateWidth}" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Context Menu on Right Click (No emojis, Rename added) -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Відкрити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).OpenItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Enter" />
                                        <MenuItem Header="Створити папку" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CreateFolderCommand}" 
                                                  InputGesture="F7" />
                                        <MenuItem Header="Перейменувати" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).RenameItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="F2" />
                                        <Separator />
                                        <MenuItem Header="Копіювати в іншу панель" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyBetweenPanesCommand}" 
                                                  InputGesture="F5" />
                                        <MenuItem Header="Перемістити в іншу панель" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).MoveBetweenPanesCommand}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="F6" />
                                        <Separator />
                                        <MenuItem Header="Копіювати шлях" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyPathCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Ctrl+Shift+C" />
                                        <Separator />
                                        <MenuItem Header="Видалити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).DeleteItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="Delete" />
                                        <Separator />
                                        <MenuItem Header="Обчислити хеш" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ComputeSha256Command}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding !IsDirectory}" />
                                        <MenuItem Header="Додати в закладки" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).AddBookmarkCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding IsDirectory}" />
                                        <Separator />
                                        <MenuItem Header="Властивості" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ShowPropertiesCommand}" 
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <Image Grid.Column="0" Source="{Binding IconBitmap}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="{Binding IsDirectory, Converter={x:Null}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" ToolTip.Tip="{Binding FullPath}" />
                                <TextBlock Grid.Column="3" Text="{Binding TypeDescription}" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                <TextBlock Grid.Column="5" Text="{Binding FormattedSize}" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                                <TextBlock Grid.Column="7" Text="{Binding FormattedDate}" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Mode 2: Large Icons Grid View (WrapPanel) -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DoubleTapped="OnItemListDoubleTapped"
                         KeyDown="OnItemListKeyDown"
                         GotFocus="OnListBoxGotFocus"
                         IsVisible="{Binding IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Width" Value="96" />
                            <Setter Property="Height" Value="92" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Border CornerRadius="8" Padding="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip.Tip="{Binding FullPath}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Відкрити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).OpenItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Enter" />
                                        <MenuItem Header="Створити папку" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CreateFolderCommand}" 
                                                  InputGesture="F7" />
                                        <MenuItem Header="Перейменувати" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).RenameItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="F2" />
                                        <Separator />
                                        <MenuItem Header="Копіювати в іншу панель" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyBetweenPanesCommand}" 
                                                  InputGesture="F5" />
                                        <MenuItem Header="Перемістити в іншу панель" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).MoveBetweenPanesCommand}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="F6" />
                                        <Separator />
                                        <MenuItem Header="Копіювати шлях" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyPathCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Ctrl+Shift+C" />
                                        <Separator />
                                        <MenuItem Header="Видалити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).DeleteItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="Delete" />
                                        <Separator />
                                        <MenuItem Header="Додати в закладки" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).AddBookmarkCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding IsDirectory}" />
                                        <Separator />
                                        <MenuItem Header="Властивості" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ShowPropertiesCommand}" 
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <Image Source="{Binding IconBitmap}" Width="40" Height="40" HorizontalAlignment="Center" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="32" HorizontalAlignment="Center" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="11" 
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center"
                                               MaxLines="2"
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxWidth="86" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ProgressBar IsIndeterminate="True" 
                             IsVisible="{Binding IsLoading}" 
                             VerticalAlignment="Top" 
                             Height="3" />
            </Grid>
        </Grid>
    </Border>
</UserControl>