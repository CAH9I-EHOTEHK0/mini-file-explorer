<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiniFileExplorer.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="MiniFileExplorer.Views.FilePaneView"
             x:Name="PaneRoot"
             x:DataType="vm:FilePaneViewModel">

    <Border BorderBrush="{Binding IsActive, Converter={x:Null}, FallbackValue=Transparent}" 
            BorderThickness="1" 
            Classes.active="{Binding IsActive}">
        <Border.Styles>
            <Style Selector="Border.active">
                <Setter Property="BorderBrush" Value="DodgerBlue" />
            </Style>
        </Border.Styles>

        <Grid RowDefinitions="Auto, Auto, *">
            <!-- Pane Navigation & Address Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                        <Button Command="{Binding GoUpCommand}" 
                                IsEnabled="{Binding CanGoUp}" 
                                ToolTip.Tip="Вгору (..)" 
                                Padding="6,3">
                            <TextBlock Text="⬆" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}" 
                                ToolTip.Tip="Оновити" 
                                Padding="6,3">
                            <TextBlock Text="🔄" />
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Column="1" 
                             Text="{Binding PathInput, Mode=TwoWay}"
                             VerticalAlignment="Center"
                             Padding="6,3" FontSize="12"
                             PlaceholderText="Шлях до папки..."
                             KeyDown="OnAddressBarKeyDown" />

                    <Button Grid.Column="2" 
                            Command="{Binding NavigateFromInputCommand}" 
                            Margin="6,0,0,0" 
                            Padding="8,3">
                        <TextBlock Text="➡" />
                    </Button>

                    <Button Grid.Column="3" 
                            Command="{Binding CalculateFolderSizesCommand}" 
                            IsEnabled="{Binding !IsCalculatingFolderSizes}"
                            ToolTip.Tip="Порахувати розміри папок"
                            Margin="6,0,0,0" 
                            Padding="8,3">
                        <TextBlock Text="📊" />
                    </Button>

                    <!-- Toggle View Mode Button (Details / Large Icons Grid) -->
                    <Button Grid.Column="4" 
                            Command="{Binding ToggleViewModeCommand}" 
                            ToolTip.Tip="{Binding ViewModeToolTip}"
                            Margin="6,0,0,0" 
                            Padding="8,3">
                        <TextBlock Text="{Binding ViewModeGlyph}" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <!-- Column Headers & In-Pane Quick Filter (Visible in Details mode) -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding IsDetailsView}"
                    Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="8,3">
                <Grid ColumnDefinitions="26, *, 85, 80, 115, 100">
                    <TextBlock Grid.Column="0" Text="" />

                    <!-- Sort by Name -->
                    <Button Grid.Column="1" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Name" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2" 
                            HorizontalAlignment="Left">
                        <TextBlock FontWeight="SemiBold" FontSize="11">
                            <Run Text="Назва" /><Run Text="{Binding NameSortIndicator}" Foreground="DodgerBlue" />
                        </TextBlock>
                    </Button>

                    <!-- Sort by Type -->
                    <Button Grid.Column="2" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Type" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2" 
                            HorizontalAlignment="Left">
                        <TextBlock FontWeight="SemiBold" FontSize="11">
                            <Run Text="Тип" /><Run Text="{Binding TypeSortIndicator}" Foreground="DodgerBlue" />
                        </TextBlock>
                    </Button>

                    <!-- Sort by Size -->
                    <Button Grid.Column="3" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Size" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2" 
                            HorizontalAlignment="Right">
                        <TextBlock FontWeight="SemiBold" FontSize="11">
                            <Run Text="Розмір" /><Run Text="{Binding SizeSortIndicator}" Foreground="DodgerBlue" />
                        </TextBlock>
                    </Button>

                    <!-- Sort by Date -->
                    <Button Grid.Column="4" 
                            Command="{Binding ToggleSortCommand}" 
                            CommandParameter="Date" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="2" 
                            HorizontalAlignment="Right">
                        <TextBlock FontWeight="SemiBold" FontSize="11">
                            <Run Text="Дата" /><Run Text="{Binding DateSortIndicator}" Foreground="DodgerBlue" />
                        </TextBlock>
                    </Button>

                    <!-- Quick Filter -->
                    <Grid Grid.Column="5" Margin="6,0,0,0" ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilterQuery, Mode=TwoWay}" 
                                 PlaceholderText="🔍..." 
                                 Padding="4,2" 
                                 FontSize="10" 
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                 Command="{Binding ClearFilterCommand}" 
                                 IsVisible="{Binding FilterQuery.Length}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="2">
                            <TextBlock Text="✕" Foreground="Gray" FontSize="9" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Quick Filter Bar in Large Icons Grid Mode -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding IsGridView}"
                    Background="{DynamicResource SystemControlBackgroundChromeLowBrush}" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="8,4">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Вигляд: Великі піктограми" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleSortCommand}" CommandParameter="Name" Background="Transparent" BorderThickness="0" Padding="4,2">
                            <TextBlock FontSize="11"><Run Text="Сортувати за ім'ям" /><Run Text="{Binding NameSortIndicator}" Foreground="DodgerBlue" /></TextBlock>
                        </Button>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="140" ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilterQuery, Mode=TwoWay}" 
                                 PlaceholderText="🔍 Фільтр..." 
                                 Padding="4,2" 
                                 FontSize="10" 
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" 
                                 Command="{Binding ClearFilterCommand}" 
                                 IsVisible="{Binding FilterQuery.Length}" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="2">
                            <TextBlock Text="✕" Foreground="Gray" FontSize="9" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Files List Area -->
            <Grid Grid.Row="2" PointerPressed="OnPanePointerPressed">
                <!-- Mode 1: Details Table ListBox -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DoubleTapped="OnItemListDoubleTapped"
                         KeyDown="OnItemListKeyDown"
                         GotFocus="OnListBoxGotFocus"
                         IsVisible="{Binding IsDetailsView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,2" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid ColumnDefinitions="26, *, 85, 80, 115, 100" Margin="0,1">
                                <!-- Context Menu on Right Click -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂 Відкрити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).OpenItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Enter" />
                                        <MenuItem Header="📁 Створити папку" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CreateFolderCommand}" 
                                                  InputGesture="F7" />
                                        <Separator />
                                        <MenuItem Header="📋 Копіювати в іншу панель (F5)" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyBetweenPanesCommand}" 
                                                  InputGesture="F5" />
                                        <MenuItem Header="🚚 Перемістити в іншу панель (F6)" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).MoveBetweenPanesCommand}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="F6" />
                                        <Separator />
                                        <MenuItem Header="📋 Копіювати як шлях" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyPathCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Ctrl+Shift+C" />
                                        <Separator />
                                        <MenuItem Header="🗑 Видалити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).DeleteItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  ToolTip.Tip="{Binding IsSystemProtected, Converter={x:Null}, FallbackValue='Видалити'}"
                                                  InputGesture="Delete" />
                                        <Separator />
                                        <MenuItem Header="🔒 Обчислити SHA-256" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ComputeSha256Command}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding !IsDirectory}" />
                                        <MenuItem Header="⭐ Додати в закладки" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).AddBookmarkCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding IsDirectory}" />
                                        <Separator />
                                        <MenuItem Header="ℹ Властивості" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ShowPropertiesCommand}" 
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding IsDirectory, Converter={x:Null}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" ToolTip.Tip="{Binding FullPath}" />
                                <TextBlock Grid.Column="2" Text="{Binding TypeDescription}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                                <TextBlock Grid.Column="4" Text="{Binding FormattedDate}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Mode 2: Large Icons Grid View (WrapPanel) -->
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DoubleTapped="OnItemListDoubleTapped"
                         KeyDown="OnItemListKeyDown"
                         GotFocus="OnListBoxGotFocus"
                         IsVisible="{Binding IsGridView}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Width" Value="92" />
                            <Setter Property="Height" Value="88" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Border CornerRadius="6" Padding="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip.Tip="{Binding FullPath}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂 Відкрити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).OpenItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Enter" />
                                        <MenuItem Header="📁 Створити папку" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CreateFolderCommand}" 
                                                  InputGesture="F7" />
                                        <Separator />
                                        <MenuItem Header="📋 Копіювати в іншу панель (F5)" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyBetweenPanesCommand}" 
                                                  InputGesture="F5" />
                                        <MenuItem Header="🚚 Перемістити в іншу панель (F6)" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).MoveBetweenPanesCommand}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="F6" />
                                        <Separator />
                                        <MenuItem Header="📋 Копіювати як шлях" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).CopyPathCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  InputGesture="Ctrl+Shift+C" />
                                        <Separator />
                                        <MenuItem Header="🗑 Видалити" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).DeleteItemCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsEnabled="{Binding !IsSystemProtected}"
                                                  InputGesture="Delete" />
                                        <Separator />
                                        <MenuItem Header="⭐ Додати в закладки" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).AddBookmarkCommand}" 
                                                  CommandParameter="{Binding}" 
                                                  IsVisible="{Binding IsDirectory}" />
                                        <Separator />
                                        <MenuItem Header="ℹ Властивості" 
                                                  Command="{Binding #PaneRoot.((vm:FilePaneViewModel)DataContext).ShowPropertiesCommand}" 
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="32" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="11" 
                                               HorizontalAlignment="Center" 
                                               TextAlignment="Center"
                                               MaxLines="2"
                                               TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxWidth="82" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ProgressBar IsIndeterminate="True" 
                             IsVisible="{Binding IsLoading}" 
                             VerticalAlignment="Top" 
                             Height="3" />
            </Grid>
        </Grid>
    </Border>
</UserControl>